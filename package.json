{
  "name": "magicarena",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev:client",
    "dev:client": "npm run dev -w client",
    "dev:server": "node --watch --env-file=server/.env server/src/index.ts",
    "build": "npm run build -w client",
    "lint": "eslint client/src server/src shared/src server/test shared/test client/test server/scripts e2e playwright.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit -p . && npm run typecheck --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:shared": "vitest run --project shared",
    "test:server": "vitest run --project server",
    "test:client": "vitest run --project client",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "audit:types": "node scripts/audit-types.mjs",
    "benchmark": "node server/scripts/codec-benchmark.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.4",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.15.0",
    "fast-check": "^4.11.0",
    "globals": "^17.14.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.1.12"
  }
}
