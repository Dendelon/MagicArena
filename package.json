{
  "name": "magicarena",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev:client",
    "dev:client": "npm run dev -w client",
    "dev:server": "node --watch --env-file=server/.env server/src/index.ts",
    "build": "npm run build -w client",
    "lint": "eslint client/src server/src shared/src",
    "typecheck": "tsc --noEmit -p . && npm run typecheck --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.4",
    "@types/ws": "^8.18.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3"
  }
}
